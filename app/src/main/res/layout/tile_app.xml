<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/tile_width"
    android:layout_height="@dimen/tile_height"
    android:layout_marginEnd="@dimen/tile_spacing"
    android:background="@drawable/tile_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/tile_focus">

    <ImageView
        android:id="@+id/tile_banner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/tile_fallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tile_glyph"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="30sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/tile_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tile_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
